#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — NEVER commit these (see docs/04-security-architecture.md §6)
.env
.env.*
supabase/.env
*.keystore
key.properties
analyze_out.txt

# Local tooling artifacts — not project source
.claude/scheduled_tasks.lock
supabase/.temp/

# Built app binaries — rebuild with `flutter build apk`, don't version 60MB+
# artifacts (they're distributed outside git).
*.apk
*.aab
